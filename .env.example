# Servidor (solo localhost: cloudflared entra por 127.0.0.1)
PORT=8094
HOST=127.0.0.1
# DATA_DIR=./data
# Token de un solo uso para crear el primer usuario (admin)
SETUP_TOKEN=cambiar
# Sesiones: días sin usar la app antes de que se cierre la sesión
SESSION_DAYS=180

# Gemini (gratis): embeddings, lectura de imágenes y respaldo del chat
GEMINI_API_KEY=
EMBED_MODEL_GEMINI=gemini-embedding-001
EMBED_PER_MINUTE=90
VISION_MODEL_GEMINI=gemini-flash-lite-latest
CHAT_MODEL_GEMINI=gemini-flash-lite-latest

# Groq (gratis): chat principal y transcripción de voz
GROQ_API_KEY=
CHAT_MODEL_GROQ=openai/gpt-oss-120b
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# auto | groq | gemini | deepseek
CHAT_PROVIDER=auto

# Opcionales de pago (solo respaldo): OpenAI para leer imágenes si Gemini falla; DeepSeek si CHAT_FALLBACK_DEEPSEEK=1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CHAT_FALLBACK_DEEPSEEK=0

# Demo pública (cuentas temporales de 24 h con apuntes de ejemplo y límites estrictos)
DEMO_ENABLED=0
DEMO_HOURS=24

# Límites gratis de Gemini por día para las barras de cuota del panel (Gemini no informa lo que queda)
GEMINI_EMBED_RPD=1000
GEMINI_FLASH_RPD=1000

# RAG
RAG_TOP_K=6
# similitud coseno mínima para considerar un fragmento relevante (calibrar con npm run eval)
RAG_MIN_SIM=0.30
RAG_CONTEXT_CHARS=9000
